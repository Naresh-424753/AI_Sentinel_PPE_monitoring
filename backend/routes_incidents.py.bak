"""Incident list, filters, workflow (OPEN -> ASSIGNED -> RESOLVED), delete and exports."""
import os
from typing import Optional

from fastapi import APIRouter, Depends, HTTPException, Query, Response
from fastapi.responses import FileResponse
from pydantic import BaseModel

from backend import config
from backend.db import get_db, log_audit, now_str
from backend.events import bus
from backend.security import get_current_user, require_role
from backend.services import report_service

router = APIRouter(tags=["incidents"])

STATUSES = ["OPEN", "ASSIGNED", "RESOLVED", "FALSE_POSITIVE"]
CLOSED = ("RESOLVED", "FALSE_POSITIVE")


def build_filters(status=None, violation=None, severity=None, camera_id=None, q=None,
                  date_from=None, date_to=None):
    where, params = [], []
    if status:
        where.append("status = ?"); params.append(status.upper())
    if violation:
        where.append("violation = ?"); params.append(violation)
    if severity:
        where.append("severity = ?"); params.append(severity.upper())
    if camera_id:
        where.append("camera_id = ?"); params.append(camera_id)
    if date_from:
        where.append("timestamp >= ?"); params.append(date_from)
    if date_to:
        where.append("timestamp <= ?"); params.append(date_to + " 23:59:59")
    if q:
        like = f"%{q}%"
        where.append("(incident_id LIKE ? OR violation LIKE ? OR camera_name LIKE ? OR assigned_to LIKE ? OR zone LIKE ?)")
        params += [like] * 5
    return (" WHERE " + " AND ".join(where)) if where else "", params


def fetch(where, params, limit=None, offset=0):
    conn = get_db()
    sql = f"SELECT * FROM incidents{where} ORDER BY id DESC"
    args = list(params)
    if limit:
        sql += " LIMIT ? OFFSET ?"
        args += [limit, offset]
    rows = [dict(r) for r in conn.execute(sql, args).fetchall()]
    total = conn.execute(f"SELECT COUNT(*) FROM incidents{where}", params).fetchone()[0]
    conn.close()
    return rows, total


@router.get("/api/incidents")
def list_incidents(
    status: Optional[str] = None, violation: Optional[str] = None, severity: Optional[str] = None,
    camera_id: Optional[int] = None, q: Optional[str] = None,
    date_from: Optional[str] = None, date_to: Optional[str] = None,
    limit: int = Query(25, ge=1, le=500), offset: int = Query(0, ge=0),
    user=Depends(get_current_user),
):
    where, params = build_filters(status, violation, severity, camera_id, q, date_from, date_to)
    items, total = fetch(where, params, limit, offset)
    return {"items": items, "total": total}


@router.get("/incidents")
def legacy_list(user=Depends(get_current_user)):
    """Original endpoint: plain list of incidents (newest first)."""
    items, _ = fetch("", [], 1000)
    return items


@router.get("/incidents/{incident_id}")
def get_incident(incident_id: str, user=Depends(get_current_user)):
    conn = get_db()
    row = conn.execute("SELECT * FROM incidents WHERE incident_id=?", (incident_id,)).fetchone()
    conn.close()
    if not row:
        raise HTTPException(404, "Incident not found")
    return dict(row)


class IncidentPatch(BaseModel):
    status: Optional[str] = None
    assigned_to: Optional[str] = None
    resolution_notes: Optional[str] = None
class UserIncidentReply(BaseModel):
    resolution_notes: str


@router.patch("/incidents/{incident_id}/reply")
def user_reply_incident(
    incident_id: str,
    body: UserIncidentReply,
    user=Depends(get_current_user),
):
    reply = body.resolution_notes.strip()

    if not reply:
        raise HTTPException(400, "Reply cannot be empty")

    conn = get_db()

    row = conn.execute(
        "SELECT * FROM incidents WHERE incident_id=?",
        (incident_id,)
    ).fetchone()

    if not row:
        conn.close()
        raise HTTPException(404, "Incident not found")

    # Only the user assigned to this incident can reply.
    assigned_to = (row["assigned_to"] or "").strip().lower()
    current_user_email = (user["email"] or "").strip().lower()

    # Support assignment by email.
    if assigned_to != current_user_email:
        conn.close()
        raise HTTPException(
            403,
            "You are not assigned to this incident"
        )

    # Save user's reply.
    conn.execute(
        """
        UPDATE incidents
        SET resolution_notes=?,
            updated_at=?
        WHERE incident_id=?
        """,
        (
            reply,
            now_str(),
            incident_id,
        )
    )

    conn.commit()

    out = dict(
        conn.execute(
            "SELECT * FROM incidents WHERE incident_id=?",
            (incident_id,)
        ).fetchone()
    )

    conn.close()

    log_audit(
        user["email"],
        "INCIDENT_REPLY",
        "incident",
        incident_id,
        reply,
    )

    bus.publish({
        "type": "incident_updated",
        "incident_id": incident_id,
    })

    return {
        "success": True,
        "message": "Reply submitted successfully",
        "incident": out,
    }



@router.patch("/incidents/{incident_id}")
def update_incident(incident_id: str, body: IncidentPatch, user=Depends(require_role("ADMIN"))):
    conn = get_db()
    row = conn.execute("SELECT * FROM incidents WHERE incident_id=?", (incident_id,)).fetchone()
    if not row:
        conn.close()
        raise HTTPException(404, "Incident not found")

    fields = {}
    if body.status is not None:
        st = body.status.upper()
        if st not in STATUSES:
            conn.close()
            raise HTTPException(400, f"Status must be one of {', '.join(STATUSES)}")
        fields["status"] = st
    if body.assigned_to is not None:
        fields["assigned_to"] = body.assigned_to.strip()
        if fields["assigned_to"] and "status" not in fields and row["status"] == "OPEN":
            fields["status"] = "ASSIGNED"
    if body.resolution_notes is not None:
        fields["resolution_notes"] = body.resolution_notes.strip()
    if fields.get("status") in CLOSED:
        fields["resolved_at"] = now_str()
    elif "status" in fields:
        fields["resolved_at"] = None
    if not fields:
        conn.close()
        raise HTTPException(400, "Nothing to update")

    fields["updated_at"] = now_str()
    cols = ", ".join(f"{k}=?" for k in fields)
    conn.execute(f"UPDATE incidents SET {cols} WHERE incident_id=?", (*fields.values(), incident_id))
    conn.commit()
    out = dict(conn.execute("SELECT * FROM incidents WHERE incident_id=?", (incident_id,)).fetchone())
    conn.close()

    detail = ", ".join(f"{k}={v}" for k, v in fields.items() if k not in ("updated_at", "resolved_at"))
    log_audit(user["email"], "INCIDENT_UPDATE", "incident", incident_id, detail)
    bus.publish({"type": "incident_updated", "incident_id": incident_id})
    return out


@router.delete("/incidents/{incident_id}")
def delete_incident(incident_id: str, user=Depends(require_role("ADMIN"))):
    conn = get_db()
    row = conn.execute("SELECT screenshot, clip FROM incidents WHERE incident_id=?", (incident_id,)).fetchone()
    if not row:
        conn.close()
        raise HTTPException(404, "Incident not found")
    conn.execute("DELETE FROM incidents WHERE incident_id=?", (incident_id,))
    conn.commit()
    conn.close()
    for folder, name in ((config.INCIDENTS_DIR, row["screenshot"]), (config.CLIPS_DIR, row["clip"])):
        if name:
            path = os.path.join(folder, os.path.basename(name))
            if os.path.exists(path):
                try:
                    os.remove(path)
                except OSError:
                    pass
    log_audit(user["email"], "INCIDENT_DELETE", "incident", incident_id)
    return {"success": True, "message": f"{incident_id} deleted"}


@router.get("/api/incidents/export")
def export_incidents(
    format: str = Query("csv", pattern="^(csv|xlsx|pdf)$"),
    status: Optional[str] = None, violation: Optional[str] = None, severity: Optional[str] = None,
    camera_id: Optional[int] = None, q: Optional[str] = None,
    date_from: Optional[str] = None, date_to: Optional[str] = None,
    user=Depends(get_current_user),
):
    where, params = build_filters(status, violation, severity, camera_id, q, date_from, date_to)
    rows, _ = fetch(where, params, 5000)
    log_audit(user["email"], "EXPORT", "incidents", format, f"{len(rows)} rows")
    if format == "csv":
        return Response(report_service.to_csv(rows), media_type="text/csv",
                        headers={"Content-Disposition": 'attachment; filename="incidents.csv"'})
    if format == "xlsx":
        return Response(report_service.to_xlsx(rows),
                        media_type="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                        headers={"Content-Disposition": 'attachment; filename="incidents.xlsx"'})
    path = report_service.generate_pdf_report(rows)
    return FileResponse(path, media_type="application/pdf", filename="Safety_Audit_Report.pdf")


@router.get("/api/export-pdf")
def export_pdf(user=Depends(get_current_user)):
    rows, _ = fetch("", [], 200)
    path = report_service.generate_pdf_report(rows)
    return FileResponse(path, media_type="application/pdf", filename="Safety_Audit_Report.pdf")
