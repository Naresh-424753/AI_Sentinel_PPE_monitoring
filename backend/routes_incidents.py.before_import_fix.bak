from backend.services import report_service
from backend.services.event_bus import bus


router = APIRouter()

CLOSED = {
    "RESOLVED",
    "FALSE_POSITIVE",
}

STATUSES = {
    "OPEN",
    "ASSIGNED",
    "IN_PROGRESS",
    "RESOLVED",
    "FALSE_POSITIVE",
}


# ============================================================
# USER HELPERS
# ============================================================

def user_name(user):
    if isinstance(user, dict):
        return (
            user.get("name")
            or user.get("email")
            or "User"
        )

    return (
        getattr(user, "name", None)
        or getattr(user, "email", None)
        or "User"
    )


def user_email(user):
    if isinstance(user, dict):
        return str(user.get("email") or "")

    return str(getattr(user, "email", "") or "")


def is_staff(user):
    if isinstance(user, dict):
        role = user.get("role")
    else:
        role = getattr(user, "role", None)

    return str(role or "").upper() in {
        "ADMIN",
        "SUPERVISOR",
    }


def is_assigned_to_user(row, user):
    assigned_to = str(
        row["assigned_to"] or ""
    ).strip().lower()

    if not assigned_to:
        return False

    email = user_email(user).strip().lower()
    name = user_name(user).strip().lower()

    return assigned_to in {
        email,
        name,
    }


def pretty(value):
    return str(value or "").replace("_", " ").title()


# ============================================================
# OVERDUE HELPER
# ============================================================

def with_overdue(row):
    due_at = row.get("due_at")
    status = str(row.get("status") or "").upper()

    overdue = False

    if due_at and status not in CLOSED:
        try:
            due = __import__("datetime").datetime.strptime(
                due_at,
                "%Y-%m-%d %H:%M:%S",
            )
            overdue = (
                due
                < __import__("datetime").datetime.now()
            )
        except (ValueError, TypeError):
            overdue = False

    row["overdue"] = overdue

    return row


# ============================================================
# FILTER BUILDER
# ============================================================

def build_filters(
    status=None,
    violation=None,
    severity=None,
    camera_id=None,
    q=None,
    date_from=None,
    date_to=None,
    assigned_to=None,
    overdue=None,
    review=None,
):
    where = []
    params = []

    if status:
        where.append("UPPER(status) = ?")
        params.append(status.strip().upper())

    if violation:
        where.append("violation = ?")
        params.append(violation)

    if severity:
        where.append("UPPER(severity) = ?")
        params.append(severity.strip().upper())

    if camera_id is not None:
        where.append("camera_id = ?")
        params.append(camera_id)

    if assigned_to:
        where.append("assigned_to LIKE ?")
        params.append(f"%{assigned_to.strip()}%")

    # --------------------------------------------------------
    # AI REVIEW FILTERS
    # --------------------------------------------------------

    if review:
        review_value = review.strip().lower()

        if review_value in ("needs", "needs_review"):
            where.append(
                """
                status IN ('OPEN', 'ASSIGNED')
                AND UPPER(COALESCE(ai_review, '')) IN (
                    'NEEDS_REVIEW',
                    'LOW_CONFIDENCE'
                )
                """
            )

        elif review_value in ("auto", "auto_resolved"):
            where.append(
                "UPPER(COALESCE(ai_review, '')) = 'AUTO_RESOLVED'"
            )

        elif review_value == "reopened":
            where.append(
                "UPPER(COALESCE(ai_review, '')) = 'REOPENED'"
            )

        elif review_value == "low_confidence":
            where.append(
                "UPPER(COALESCE(ai_review, '')) = 'LOW_CONFIDENCE'"
            )

        # Explicit exact NEEDS_REVIEW filter
        elif review_value == "needs_review_exact":
            where.append(
                "UPPER(COALESCE(ai_review, '')) = 'NEEDS_REVIEW'"
            )

        else:
            raise HTTPException(
                status_code=400,
                detail="Invalid AI review filter",
            )

    # --------------------------------------------------------
    # DATE FILTERS
    # --------------------------------------------------------

    if date_from:
        where.append("timestamp >= ?")
        params.append(date_from)

    if date_to:
        where.append("timestamp <= ?")
        params.append(date_to + " 23:59:59")

    # --------------------------------------------------------
    # SEARCH
    # --------------------------------------------------------

    if q:
        like = f"%{q.strip()}%"

        where.append(
            """
            (
                incident_id LIKE ?
                OR violation LIKE ?
                OR camera_name LIKE ?
                OR assigned_to LIKE ?
                OR zone LIKE ?
                OR description LIKE ?
            )
            """
        )

        params.extend([like] * 6)

    # --------------------------------------------------------
    # OVERDUE FILTER
    # --------------------------------------------------------

    if overdue is True:
        where.append(
            """
            due_at IS NOT NULL
            AND due_at < ?
            AND UPPER(COALESCE(status, '')) NOT IN (
                'RESOLVED',
                'FALSE_POSITIVE'
            )
            """
        )
        params.append(now_str())

    elif overdue is False:
        where.append(
            """
            (
                due_at IS NULL
                OR due_at >= ?
                OR UPPER(COALESCE(status, '')) IN (
                    'RESOLVED',
                    'FALSE_POSITIVE'
                )
            )
            """
        )
        params.append(now_str())

    if not where:
        return "", params

    return " WHERE " + " AND ".join(where), params


# ============================================================
# FETCH INCIDENTS
# ============================================================

def fetch(where, params, limit=None, offset=0):
    conn = get_db()

    try:
        sql = f"""
            SELECT *
            FROM incidents
            {where}
            ORDER BY id DESC
        """

        args = list(params)

        if limit is not None:
            sql += " LIMIT ? OFFSET ?"
            args.extend([
                int(limit),
                int(offset),
            ])

        rows = [
            with_overdue(dict(row))
            for row in conn.execute(
                sql,
                args,
            ).fetchall()
        ]

        total = conn.execute(
            f"""
            SELECT COUNT(*)
            FROM incidents
            {where}
            """,
            params,
        ).fetchone()[0]

        return rows, total

    finally:
        conn.close()


# ============================================================
# SAVE PROOF IMAGE
# ============================================================

def save_proof(incident_id, data):
    """
    Accept raw base64 or a data:image/...;base64,... URL.
    Store a resized JPEG in PROOFS_DIR.
    """

    if not data:
        return None

    if "," in data[:200]:
        header, data = data.split(",", 1)

        if not header.lower().startswith("data:image/"):
            raise HTTPException(
                status_code=400,
                detail="Invalid image data URL",
            )

    try:
        raw = base64.b64decode(
            data,
            validate=True,
        )
    except Exception:
        raise HTTPException(
            status_code=400,
            detail="Invalid image data",
        )

    if len(raw) > 8 * 1024 * 1024:
        raise HTTPException(
            status_code=413,
            detail="Image is too large (max 8 MB)",
        )

    image = cv2.imdecode(
        np.frombuffer(raw, np.uint8),
        cv2.IMREAD_COLOR,
    )

    if image is None:
        raise HTTPException(
            status_code=400,
            detail="Uploaded data is not a valid image",
        )

    height, width = image.shape[:2]

    if width <= 0 or height <= 0:
        raise HTTPException(
            status_code=400,
            detail="Invalid image dimensions",
        )

    max_size = 1280
    scale = min(1.0, max_size / max(width, height))

    if scale < 1:
        image = cv2.resize(
            image,
            (
                max(1, int(width * scale)),
                max(1, int(height * scale)),
            ),
            interpolation=cv2.INTER_AREA,
        )

    os.makedirs(
        config.PROOFS_DIR,
        exist_ok=True,
    )

    filename = (
        f"{incident_id}_"
        f"{secrets.token_hex(6)}.jpg"
    )

    path = os.path.join(
        config.PROOFS_DIR,
        filename,
    )

    ok = cv2.imwrite(
        path,
        image,
        [
            cv2.IMWRITE_JPEG_QUALITY,
            85,
        ],
    )

    if not ok:
        raise HTTPException(
            status_code=500,
            detail="Failed to save proof image",
        )

    return filename


# ============================================================
# SYSTEM COMMENTS
# ============================================================

def add_system_comment(conn, incident_id, message):
    conn.execute(
        """
        INSERT INTO incident_comments (
            incident_id,
            author,
            author_email,
            message,
            created_at
        )
        VALUES (?, ?, ?, ?, ?)
        """,
        (
            incident_id,
            "System",
            "",
            message,
            now_str(),
        ),
    )


# ============================================================
# NOTIFICATION HELPERS
# ============================================================

def notify_assignment(
    incident_id,
    incident_row,
    assigned_to,
    assigned_by_user,
):
    if not assigned_to:
        return

    try:
        users = notify.find_users(assigned_to)

        targets = [
            item.get("email")
            for item in users
            if item.get("email")
        ]

        if not targets:
            return

        violation = pretty(incident_row.get("violation"))
        camera = incident_row.get("camera_name") or "camera"

        message = (
            f"{incident_id} ({violation} on {camera}) "
            f"was assigned to you by "
            f"{user_name(assigned_by_user)}. "
            f"Deadline: {incident_row.get('due_at') or '-'}."
        )

        notify.notify(
            targets,
            f"Assigned to you: {incident_id}",
            message,
            incident_id,
            email=True,
            exclude=user_email(assigned_by_user),
        )

    except Exception as exc:
        print("assignment notification error:", exc)


def notify_resolution(incident_id, incident_row, user):
    try:
        assigned_by = incident_row.get("assigned_by")

        if assigned_by:
            targets = [assigned_by]
        else:
            targets = [
                item.get("email")
                for item in notify.users_with_role("SUPERVISOR")
                if item.get("email")
            ]

        targets = [target for target in targets if target]

        if not targets:
            return

        violation = pretty(incident_row.get("violation"))
        camera = incident_row.get("camera_name") or "camera"

        notify.notify(
            targets,
            f"Resolved: {incident_id}",
            (
                f"{incident_id} ({violation} on {camera}) "
                f"was marked resolved by {user_name(user)}."
            ),
            incident_id,
            email=True,
            exclude=user_email(user),
        )

    except Exception as exc:
        print("resolution notification error:", exc)


def notify_reply(
    incident_id,
    user,
    message,
    assigned_to,
    assigned_by,
):
    try:
        if not assigned_to:
            return

        assignee_users = notify.find_users(assigned_to)

        assignee_emails = [
            item.get("email")
            for item in assignee_users
            if item.get("email")
        ]

        current_email = user_email(user).lower()

        assignee_email_set = {
            email.lower()
            for email in assignee_emails
        }

        if current_email in assignee_email_set:
            if assigned_by:
                targets = [assigned_by]
            else:
                targets = [
                    item.get("email")
                    for item in notify.users_with_role("SUPERVISOR")
                    if item.get("email")
                ]
        else:
            targets = assignee_emails

        targets = [
            target
            for target in targets
            if target and target.lower() != current_email
        ]

        if targets:
            notify.notify(
                targets,
                f"New reply on {incident_id}",
                f"{user_name(user)}: {message[:140]}",
                incident_id,
                email=True,
                exclude=user_email(user),
            )

    except Exception as exc:
        print("reply notification error:", exc)


# ============================================================
# LIST INCIDENTS
# ============================================================

@router.get("/api/incidents")
def list_incidents(
    status: Optional[str] = None,
    violation: Optional[str] = None,
    severity: Optional[str] = None,
    camera_id: Optional[int] = None,
    q: Optional[str] = None,
    date_from: Optional[str] = None,
    date_to: Optional[str] = None,
    assigned_to: Optional[str] = None,
    overdue: Optional[bool] = None,
    review: Optional[str] = None,
    limit: int = Query(25, ge=1, le=500),
    offset: int = Query(0, ge=0),
    user=Depends(get_current_user),
):
    where, params = build_filters(
        status=status,
        violation=violation,
        severity=severity,
        camera_id=camera_id,
        q=q,
        date_from=date_from,
        date_to=date_to,
        assigned_to=assigned_to,
        overdue=overdue,
        review=review,
    )

    items, total = fetch(
        where,
        params,
        limit,
        offset,
    )

    return {
        "items": items,
        "total": total,
        "limit": limit,
        "offset": offset,
    }


