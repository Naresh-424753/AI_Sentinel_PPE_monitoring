@router.get("/incidents/{incident_id}")
def get_incident(
    incident_id: str,
    user=Depends(get_current_user),
):
    conn = get_db()

    try:
        row = conn.execute(
            """
            SELECT *
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        return with_overdue(dict(row))

    finally:
        conn.close()


# ============================================================
# REQUEST MODELS
# ============================================================

class IncidentPatch(BaseModel):
    status: Optional[str] = None
    assigned_to: Optional[str] = None
    resolution_notes: Optional[str] = None


class UserIncidentReply(BaseModel):
    resolution_notes: str = Field(
        ...,
        min_length=1,
        max_length=2000,
    )


class CommentBody(BaseModel):
    message: str = Field(default="", max_length=1000)
    image: Optional[str] = None


# ============================================================
# ASSIGNED USER REPLY
# ============================================================

@router.patch("/incidents/{incident_id}/reply")
def user_reply_incident(
    incident_id: str,
    body: UserIncidentReply,
    user=Depends(get_current_user),
):
    reply = body.resolution_notes.strip()

    if not reply:
        raise HTTPException(
            status_code=400,
            detail="Reply cannot be empty",
        )

    conn = get_db()

    try:
        row = conn.execute(
            """
            SELECT *
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        if not is_assigned_to_user(row, user):
            raise HTTPException(
                status_code=403,
                detail="You are not assigned to this incident",
            )

        if str(row["status"] or "").upper() in CLOSED:
            raise HTTPException(
                status_code=400,
                detail="This incident is already closed",
            )

        timestamp = now_str()

        conn.execute(
            """
            UPDATE incidents
            SET resolution_notes = ?, updated_at = ?
            WHERE incident_id = ?
            """,
            (
                reply,
                timestamp,
                incident_id,
            ),
        )

        conn.execute(
            """
            INSERT INTO incident_comments (
                incident_id,
                author,
                author_email,
                message,
                created_at
            )
            VALUES (?, ?, ?, ?, ?)
            """,
            (
                incident_id,
                user_name(user),
                user_email(user),
                reply,
                timestamp,
            ),
        )

        conn.commit()

        updated = conn.execute(
            """
            SELECT *
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        out = with_overdue(dict(updated))

        assigned_to = row["assigned_to"]
        assigned_by = row["assigned_by"]

    finally:
        conn.close()

    log_audit(
        user_email(user),
        "INCIDENT_REPLY",
        "incident",
        incident_id,
        reply[:80],
    )

    bus.publish({
        "type": "incident_updated",
        "incident_id": incident_id,
    })

    bus.publish({
        "type": "comment",
        "incident_id": incident_id,
    })

    notify_reply(
        incident_id,
        user,
        reply,
        assigned_to,
        assigned_by,
    )

    return {
        "success": True,
        "message": "Reply submitted successfully",
        "incident": out,
    }


# ============================================================
# UPDATE INCIDENT
# ============================================================

@router.patch("/incidents/{incident_id}")
def update_incident(
    incident_id: str,
    body: IncidentPatch,
    user=Depends(get_current_user),
):
    conn = get_db()

    try:
        row = conn.execute(
            """
            SELECT *
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        staff = is_staff(user)
        mine = is_assigned_to_user(row, user)

        if not staff:
            if not mine:
                raise HTTPException(
                    status_code=403,
                    detail=(
                        "Only the assigned person "
                        "or a supervisor can update this incident"
                    ),
                )

            if body.assigned_to is not None:
                raise HTTPException(
                    status_code=403,
                    detail="Only a supervisor can reassign an incident",
                )

            if (
                body.status is not None
                and body.status.strip().upper() != "RESOLVED"
            ):
                raise HTTPException(
                    status_code=403,
                    detail="You can only mark your incident as resolved",
                )

        fields = {}

        if body.status is not None:
            new_status = body.status.strip().upper()

            if new_status not in STATUSES:
                raise HTTPException(
                    status_code=400,
                    detail="Invalid incident status",
                )

            fields["status"] = new_status

        if body.assigned_to is not None:
            assigned = body.assigned_to.strip()

            fields["assigned_to"] = assigned or None

        if body.resolution_notes is not None:
            fields["resolution_notes"] = (
                body.resolution_notes.strip()
            )

        old_status = str(row["status"] or "").upper()
        old_ai_review = str(row["ai_review"] or "").upper()

        old_assigned = str(row["assigned_to"] or "").strip()
        new_assigned = str(
            fields.get("assigned_to", row["assigned_to"]) or ""
        ).strip()

        assignment_changed = (
            "assigned_to" in fields
            and new_assigned != old_assigned
        )

        if assignment_changed:
            fields["assigned_by"] = (
                user_email(user) if new_assigned else None
            )

            if new_assigned and "status" not in fields:
                if old_status == "OPEN":
                    fields["status"] = "ASSIGNED"

        new_status = fields.get("status", old_status)

        if new_status != old_status:
            fields["resolved_at"] = (
                now_str() if new_status in CLOSED else None
            )

        reopened = (
            old_ai_review == "AUTO_RESOLVED"
            and new_status in {"OPEN", "ASSIGNED"}
            and new_status != old_status
        )

        if reopened:
            fields["ai_review"] = "REOPENED"

        if not fields:
            raise HTTPException(
                status_code=400,
                detail="Nothing to update",
            )

        fields["updated_at"] = now_str()

        columns = ", ".join(
            f"{key} = ?"
            for key in fields
        )

        conn.execute(
            f"""
            UPDATE incidents
            SET {columns}
            WHERE incident_id = ?
            """,
            (
                *fields.values(),
                incident_id,
            ),
        )

        actor = user_name(user)

        if reopened:
            add_system_comment(
                conn,
                incident_id,
                f"Reopened by {actor} (the AI had marked it solved)",
            )

        if assignment_changed:
            add_system_comment(
                conn,
                incident_id,
                f"Assigned to {new_assigned or 'Nobody'} by {actor}",
            )

        if new_status == "RESOLVED" and old_status != "RESOLVED":
            add_system_comment(
                conn,
                incident_id,
                f"Marked resolved by {actor}",
            )

        if (
            new_status == "FALSE_POSITIVE"
            and old_status != "FALSE_POSITIVE"
        ):
            add_system_comment(
                conn,
                incident_id,
                f"Marked as false alarm by {actor}",
            )

        conn.commit()

        updated_row = conn.execute(
            """
            SELECT *
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        out = with_overdue(dict(updated_row))

    finally:
        conn.close()

    detail = ", ".join(
        f"{key}={value}"
        for key, value in fields.items()
        if key not in {"updated_at", "resolved_at"}
    )

    log_audit(
        user_email(user),
        "INCIDENT_UPDATE",
        "incident",
        incident_id,
        detail,
    )

    bus.publish({
        "type": "incident_updated",
        "incident_id": incident_id,
    })

    if assignment_changed and new_assigned:
        notify_assignment(
            incident_id,
            out,
            new_assigned,
            user,
        )

    if new_status == "RESOLVED" and old_status != "RESOLVED":
        notify_resolution(
            incident_id,
            out,
            user,
        )

    return out


# ============================================================
# LIST COMMENTS
# ============================================================

@router.get("/incidents/{incident_id}/comments")
def list_comments(
    incident_id: str,
    user=Depends(get_current_user),
):
    conn = get_db()

    try:
        incident = conn.execute(
            """
            SELECT incident_id
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not incident:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        rows = conn.execute(
            """
            SELECT *
            FROM incident_comments
            WHERE incident_id = ?
            ORDER BY id ASC
            """,
            (incident_id,),
        ).fetchall()

        return [dict(row) for row in rows]

    finally:
        conn.close()


# ============================================================
# ADD COMMENT
# ============================================================

@router.post("/incidents/{incident_id}/comments")
def add_comment(
    incident_id: str,
    body: CommentBody,
    user=Depends(get_current_user),
):
    message = body.message.strip()

    if not message and not body.image:
        raise HTTPException(
            status_code=400,
            detail="Write a message or attach a photo",
        )

    conn = get_db()

    try:
        row = conn.execute(
            """
            SELECT assigned_to, assigned_by, status
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        if not (is_staff(user) or is_assigned_to_user(row, user)):
            raise HTTPException(
                status_code=403,
                detail="Only the assigned person or a supervisor can reply",
            )

        attachment = (
            save_proof(incident_id, body.image)
            if body.image
            else None
        )

        timestamp = now_str()
        stored_message = message or "[Photo]"

        conn.execute(
            """
            INSERT INTO incident_comments (
                incident_id,
                author,
                author_email,
                message,
                attachment,
                created_at
            )
            VALUES (?, ?, ?, ?, ?, ?)
            """,
            (
                incident_id,
                user_name(user),
                user_email(user),
                stored_message,
                attachment,
                timestamp,
            ),
        )

        conn.execute(
            """
            UPDATE incidents
            SET updated_at = ?
            WHERE incident_id = ?
            """,
            (
                timestamp,
                incident_id,
            ),
        )

        conn.commit()

        assigned_to = row["assigned_to"]
        assigned_by = row["assigned_by"]

    finally:
        conn.close()

    log_audit(
        user_email(user),
        "INCIDENT_REPLY",
        "incident",
        incident_id,
        stored_message[:80],
    )

    bus.publish({
        "type": "comment",
        "incident_id": incident_id,
    })

    bus.publish({
        "type": "incident_updated",
        "incident_id": incident_id,
    })

    notify_reply(
        incident_id,
        user,
        message or "sent a photo",
        assigned_to,
        assigned_by,
    )

    return {
        "success": True,
        "message": "Comment added successfully",
        "attachment": attachment,
    }


# ============================================================
# DELETE INCIDENT
# ============================================================

@router.delete("/incidents/{incident_id}")
def delete_incident(
    incident_id: str,
    user=Depends(require_role("ADMIN")),
):
    conn = get_db()

    try:
        row = conn.execute(
            """
            SELECT screenshot, clip
            FROM incidents
            WHERE incident_id = ?
            """,
            (incident_id,),
        ).fetchone()

        if not row:
            raise HTTPException(
                status_code=404,
                detail="Incident not found",
            )

        proof_rows = conn.execute(
            """
            SELECT attachment
            FROM incident_comments
            WHERE incident_id = ?
              AND attachment IS NOT NULL
            """,
            (incident_id,),
        ).fetchall()

        proofs = [
            item["attachment"]
            for item in proof_rows
            if item["attachment"]
        ]

        conn.execute(
            "DELETE FROM incident_comments WHERE incident_id = ?",
            (incident_id,),
        )

        conn.execute(
            "DELETE FROM incidents WHERE incident_id = ?",
            (incident_id,),
        )

        conn.commit()

    finally:
        conn.close()

    files = [
        (config.INCIDENTS_DIR, row["screenshot"]),
        (config.CLIPS_DIR, row["clip"]),
    ]

    files.extend(
        (config.PROOFS_DIR, filename)
        for filename in proofs
    )

    files.extend([
        (config.TRAINING_DIR, f"{incident_id}.jpg"),
        (config.TRAINING_DIR, f"{incident_id}.txt"),
    ])

    for folder, filename in files:
        if not filename:
            continue

        path = os.path.join(
            folder,
            os.path.basename(filename),
        )

        try:
            if os.path.isfile(path):
                os.remove(path)
        except OSError as exc:
            print("file delete error:", exc)

    log_audit(
        user_email(user),
        "INCIDENT_DELETE",
        "incident",
        incident_id,
    )

    bus.publish({
        "type": "incident_deleted",
        "incident_id": incident_id,
    })

    return {
        "success": True,
        "message": f"{incident_id} deleted",
    }


# ============================================================
# EXPORT INCIDENTS
# ============================================================

@router.get("/api/incidents/export")
def export_incidents(
    format: str = Query(
        "csv",
        pattern="^(csv|xlsx|pdf)$",
    ),
    status: Optional[str] = None,
    violation: Optional[str] = None,
    severity: Optional[str] = None,
    camera_id: Optional[int] = None,
    q: Optional[str] = None,
    date_from: Optional[str] = None,
    date_to: Optional[str] = None,
    assigned_to: Optional[str] = None,
    overdue: Optional[bool] = None,
    review: Optional[str] = None,
    user=Depends(get_current_user),
):
    where, params = build_filters(
        status=status,
        violation=violation,
        severity=severity,
        camera_id=camera_id,
        q=q,
        date_from=date_from,
        date_to=date_to,
        assigned_to=assigned_to,
        overdue=overdue,
        review=review,
    )

    rows, _ = fetch(where, params, 5000, 0)

    log_audit(
        user_email(user),
        "EXPORT",
        "incidents",
        format,
        f"{len(rows)} rows",
    )

    if format == "csv":
        return Response(
            report_service.to_csv(rows),
            media_type="text/csv",
            headers={
                "Content-Disposition":
                    'attachment; filename="incidents.csv"'
            },
        )

    if format == "xlsx":
        return Response(
            report_service.to_xlsx(rows),
            media_type=(
                "application/vnd.openxmlformats-officedocument."
                "spreadsheetml.sheet"
            ),
            headers={
                "Content-Disposition":
                    'attachment; filename="incidents.xlsx"'
            },
        )

    path = report_service.generate_pdf_report(rows)

    return FileResponse(
        path,
        media_type="application/pdf",
        filename="Safety_Audit_Report.pdf",
    )


