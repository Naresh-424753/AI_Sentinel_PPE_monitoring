# Copy this file to ".env" (same folder) and fill what you need. Everything is optional except SMTP if you use password reset by email.

# ---------- detection ----------
# MODEL_PATH=runs/detect/train-2/weights/best.pt
CONFIDENCE_THRESHOLD=0.35
REQUIRED_FRAMES=3            # a violation must be seen in this many checks in a row
FRAME_SKIP=2                 # run YOLO on every 2nd frame (raise to 3-4 on slow PCs)
INCIDENT_COOLDOWN=120        # seconds before an ongoing violation is reported again
CAMERA_SOURCE=0              # first camera created on a fresh database (0 = webcam, or rtsp://...)
# VIOLATION_CLASSES=no_helmet,no_goggle   # empty = every class starting with "no_"
# DISABLE_DETECTION=true     # run only API + dashboard (no camera / no model needed)

# ---------- security ----------
# JWT_SECRET=change-me        # if empty, a random one is generated and saved in backend/.jwt_secret
JWT_EXPIRE_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- email (password reset OTP + email alerts) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=               # Gmail: use an App Password, not your real password

# ---------- alerts (leave blank to disable a channel) ----------
ALERT_MIN_SEVERITY=MEDIUM    # LOW | MEDIUM | HIGH | CRITICAL
ALERT_EMAILS=                # comma separated
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_WHATSAPP_FROM=        # whatsapp:+14155238886
WHATSAPP_TO=                 # whatsapp:+91XXXXXXXXXX,whatsapp:+91YYYYYYYYYY
ALERT_WEBHOOK_URL=
PUBLIC_API_URL=http://127.0.0.1:8000   # must be a public URL for WhatsApp images to arrive
FRONTEND_URL=http://localhost:5173
